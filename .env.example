# ==============================================================================
# SmartCash — Variables de Entorno de Ejemplo
# ==============================================================================
# Copia este archivo como .env para desarrollo local o define estas variables en
# tu entorno de ejecucion / servidor de produccion.
# NUNCA subas archivos .env con credenciales reales a GitHub.
# ==============================================================================

# Contraseña de la base de datos PostgreSQL
# (Utilizada por usuarios_user y transacciones_user)
DB_PASSWORD=tu_password_de_postgres_aqui

# Secreto para la generacion y validacion de tokens JWT
# DEBE ser una cadena de al menos 256 bits (32 caracteres o mas) y ser IDENTICA
# en todos los microservicios que validen tokens.
JWT_SECRET=tu_clave_secreta_super_segura_de_al_menos_256_bits_1234567890
