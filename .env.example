# ==============================================================================
# SmartCash - Variables de entorno (copiar este archivo como .env y completar)
# NUNCA subir el archivo .env real a Git.
# ==============================================================================

# --- Base de datos (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_esta_clave
DB_PASSWORD=cambiar_esta_clave

# --- Seguridad (JWT): minimo 256 bits (32+ caracteres) ---
JWT_SECRET=cambiar_por_una_clave_larga_y_aleatoria_de_minimo_32_caracteres

# --- Correo (Brevo). Con "mock-key" no se envian correos reales ---
EMAIL_API_KEY=mock-key
EMAIL_REMITENTE=soporte@smartcash.com
EMAIL_REMITENTE_NOMBRE=SmartCash

# --- Direcciones y red ---
# URL publica del frontend (enlaces de los correos)
FRONTEND_URL=http://localhost:5173
# Origenes permitidos por CORS, separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://192.168.*:*,http://10.*:*,http://172.*:*

# --- Operacion ---
LOG_LEVEL=INFO
JPA_DDL_AUTO=update

# --- Frontend (ruta del contexto de construccion) ---
FRONTEND_CONTEXT=../SmartCash-Frontend-/SmartCash-Frontend/frontend_new
